---
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';
import { resolveAssetImage } from '../utils/images';
import { Image } from 'astro:assets';

const { name, photoUrl, resumeUrl, socials } = localData;
const profileImage = await resolveAssetImage(photoUrl);
const resumeHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${resumeUrl}`;
---

<section id="home" class="section-container hero-section flex flex-col items-center text-center">
  <div class="mb-5 h-36 w-36 overflow-hidden rounded-full border-2 border-accent/50 sm:h-44 sm:w-44 md:h-48 md:w-48">
    {profileImage ? (
      <Image src={profileImage} alt={name} class="h-full w-full object-cover scale-110" loading="eager" />
    ) : (
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/placeholder.jpeg`} alt={name} class="h-full w-full object-cover" />
    )}
  </div>
  <div class="mx-auto w-full max-w-4xl">
    <p class="mb-1 text-sm text-subtext">Hola, soy</p>
    <h1 class="font-heading text-4xl font-bold tracking-tight text-maintext sm:text-5xl md:text-6xl">{name}</h1>
    <p class="mt-3 font-heading text-xl font-medium text-maintext sm:text-2xl">{localData.role}</p>
    <p class="availability-badge mx-auto mt-5 inline-flex max-w-full items-center justify-center gap-2 rounded-full border px-4 py-2 text-[15px] font-medium sm:text-base">
      <span class="h-2 w-2 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
      <span>{localData.availability}</span>
    </p>
    <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-subtext" set:html={localData.intro} />
  </div>
  <a href={resumeHref} target="_blank" rel="noopener noreferrer" class="primary-button mt-7 inline-flex min-h-13 items-center justify-center gap-3 rounded-xl px-7 py-3 font-semibold" aria-label="Descargar currículum vitae en PDF (abre otra pestaña)">
    <Icon name="mdi:file-document-outline" class="h-5 w-5" />
    Currículum vitae
    <Icon name="mdi:download" class="h-5 w-5" />
  </a>
  <div class="mt-5 flex gap-3">
    {socials.filter(social => social.url && social.url !== '#').map(social => (
      <a href={social.url} target="_blank" rel="noopener noreferrer" class="social-link inline-flex h-11 w-11 items-center justify-center rounded-xl text-subtext hover:text-maintext" aria-label={social.name} title={social.name}>
        <Icon name={social.icon} class="h-6 w-6" />
      </a>
    ))}
  </div>
</section>

<style>
  .hero-section { padding-top: 4.5rem; padding-bottom: 3rem; }
  .availability-badge { color: var(--color-accent); border-color: var(--surface-border); background: var(--surface); }
  .social-link:hover { background: var(--surface); }
  @media (min-width: 768px) { .hero-section { padding-top: 7.5rem; padding-bottom: 4rem; } }
</style>
