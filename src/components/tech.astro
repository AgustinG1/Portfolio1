---
import { Icon } from 'astro-icon/components';
import techData from '../data/tech.json';

// Use the reviewed categories consistently in development and production.
const { categories } = techData;
---

<section id="tech" class="section-container">
  <div class="container mx-auto">
    <div class="mb-12">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-maintext mb-2 flex items-center gap-4">
        <span class="text-accent">/</span> Tecnologías y herramientas
      </h2>
      <p class="text-subtext font-body text-sm max-w-md">
        Tecnologías con las que trabajo en mis proyectos y formación.
      </p>
    </div>

    <div class="space-y-8">
      {categories.map((category) => (
        <div class="space-y-3">
          <h3 class="text-maintext font-body text-xs font-semibold uppercase tracking-widest">
            {category.title}
          </h3>
          <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3" aria-label={category.title}>
            {category.skills.map((skill) => (
              <li class="group min-w-0 flex items-center gap-3 rounded-xl border border-accent/15 bg-accent/5 p-3 transition-colors hover:border-accent/40 hover:bg-accent/10">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent/10" aria-hidden="true">
                  <Icon name={skill.icon} class="h-7 w-7" />
                </span>
                <span class="min-w-0 break-words font-body text-maintext text-[13px] leading-5 font-medium">
                  {skill.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
