---
import { Icon } from 'astro-icon/components';
import profile from '../data/home.json';
const contactItems = [
  ...profile.socials.filter(social => social.showInContact && social.url && social.url !== '#').map(social => ({
    name: social.name,
    url: social.url,
    icon: social.icon,
    description: social.name === 'GitHub' ? 'Explora mi código y proyectos' : social.name === 'LinkedIn' ? 'Conectemos profesionalmente' : 'Hablemos de una oportunidad',
  })),
  { name: 'Currículum vitae', url: `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${profile.resumeUrl}`, icon: 'mdi:file-document-outline', description: 'Descarga mi perfil en PDF' },
];
---
<section id="contact" class="section-container">
  <div class="container mx-auto">
    <h2 class="mb-3 flex items-center gap-4 font-heading text-3xl font-bold text-maintext md:text-4xl"><span class="text-accent">/</span> Contacto</h2>
    <p class="mb-8 text-base text-subtext">¿Buscas sumar un desarrollador a tu equipo? Conversemos.</p>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {contactItems.map(item => (
        <a href={item.url} target="_blank" rel="noopener noreferrer" class="portfolio-surface group flex min-w-0 flex-col items-start gap-3 rounded-2xl border p-5 transition-colors hover:border-accent" aria-label={`${item.name} (abre otra pestaña)`}>
          <Icon name={item.icon} class="h-8 w-8 text-accent" />
          <h3 class="font-heading text-lg font-semibold text-maintext">{item.name}</h3>
          <p class="text-sm leading-6 text-subtext">{item.description}</p>
          <Icon name="mdi:arrow-top-right" class="mt-auto h-5 w-5 self-end text-subtext group-hover:text-maintext" />
        </a>
      ))}
    </div>
    <footer class="mt-14 border-t border-[var(--surface-border)] pt-6 text-sm text-subtext">{profile.name} © {new Date().getFullYear()}</footer>
  </div>
</section>
