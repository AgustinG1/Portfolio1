---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './theme-toggle.astro';
const navItems = [
  { label: 'Sobre mí', href: '#home', icon: 'mdi:home-outline' },
  { label: 'Proyectos', href: '#projects', icon: 'mdi:code-braces' },
  { label: 'Tecnologías', href: '#tech', icon: 'mdi:code-tags' },
  { label: 'Contacto', href: '#contact', icon: 'mdi:email-outline' },
];
---

<div id="theme-toggle-wrapper" class="fixed right-4 top-4 z-50">
  <ThemeToggle />
</div>
<nav id="main-nav" aria-label="Navegación principal">
  <ul class="flex items-center justify-center gap-1 p-2 sm:gap-2">
    {navItems.map((item, index) => (
      <li class="min-w-0 flex-1 md:flex-none">
        <a href={item.href} aria-current={index === 0 ? 'location' : undefined}>
          <Icon name={item.icon} class="h-5 w-5 md:hidden" />
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav { position: fixed; z-index: 40; left: 50%; bottom: 0; width: 100%; transform: translateX(-50%); background: var(--surface); border: 1px solid var(--surface-border); border-radius: 16px 16px 0 0; box-shadow: var(--surface-shadow); }
  nav a { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; min-height: 52px; padding: 6px 10px; border-radius: 10px; color: var(--color-subtext); font-size: 12px; font-weight: 500; transition: background-color .2s, color .2s; }
  nav a:hover { color: var(--color-maintext); background: var(--surface-hover); }
  nav a[aria-current] { color: var(--color-maintext); background: var(--surface-hover); font-weight: 700; }
  nav a[aria-current]::after { position: absolute; bottom: 2px; left: 25%; right: 25%; height: 3px; border-radius: 2px; background: var(--color-accent); content: ''; }
  @media (min-width: 768px) {
    nav { top: 16px; bottom: auto; width: max-content; max-width: calc(100% - 140px); border-radius: 18px; }
    nav a { min-height: 44px; padding: 10px 20px; font-size: 15px; }
  }
</style>

<script>
  function initNavigation() {
    const nav = document.getElementById('main-nav');
    if (!nav || nav.dataset.ready) return;
    nav.dataset.ready = 'true';
    const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
    let scheduled = false;
    const update = () => {
      const marker = window.innerWidth >= 768 ? 150 : 80;
      let active = sections[0]?.id;
      sections.forEach(section => { if (section.getBoundingClientRect().top <= marker) active = section.id; });
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4) active = sections.at(-1)?.id;
      links.forEach(link => {
        if (link.hash === `#${active}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      scheduled = false;
    };
    const schedule = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
  initNavigation();
  document.addEventListener('astro:page-load', initNavigation);
</script>
